/* ============================================================ PLATAFORMA */

model User {
  id               String       @id @default(uuid(7)) @db.Uuid
  email            String       @unique @db.VarChar(254)
  passwordHash     String       @map("password_hash")
  name             String       @db.VarChar(120)
  phone            String?      @db.VarChar(20)
  status           UserStatus   @default(ACTIVE)
  platformRole     PlatformRole? @map("platform_role")
  mfaEnabled       Boolean      @default(false) @map("mfa_enabled")
  mfaSecretEnc     String?      @map("mfa_secret_enc")
  failedLoginCount Int          @default(0) @map("failed_login_count")
  lockedUntil      DateTime?    @map("locked_until") @db.Timestamptz(3)
  lastLoginAt      DateTime?    @map("last_login_at") @db.Timestamptz(3)
  emailVerifiedAt  DateTime?    @map("email_verified_at") @db.Timestamptz(3)
  passwordChangedAt DateTime?   @map("password_changed_at") @db.Timestamptz(3)
  /// Senha provisória definida pelo dono/administrador: troca obrigatória no próximo login.
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions            Session[]
  memberships         TenantMembership[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Session {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  refreshHash  String    @map("refresh_hash") @db.VarChar(128)
  tenantId     String?   @map("tenant_id") @db.Uuid
  membershipId String?   @map("membership_id") @db.Uuid
  mfaVerified  Boolean   @default(false) @map("mfa_verified")
  userAgent    String?   @map("user_agent") @db.VarChar(300)
  ipHash       String?   @map("ip_hash") @db.VarChar(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason String?   @map("revoke_reason") @db.VarChar(60)
  rotatedAt    DateTime? @map("rotated_at") @db.Timestamptz(3)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Tenant {
  id                    String       @id @default(uuid(7)) @db.Uuid
  name                  String       @db.VarChar(160)
  legalName             String?      @map("legal_name") @db.VarChar(200)
  document              String?      @db.VarChar(20)
  status                TenantStatus @default(PENDING_PAYMENT)
  timezone              String       @default("America/Sao_Paulo") @db.VarChar(64)
  phone                 String?      @db.VarChar(20)
  email                 String?      @db.VarChar(254)
  address               Json?
  primaryColor          String?      @map("primary_color") @db.VarChar(7)
  onboardingCompletedAt DateTime?    @map("onboarding_completed_at") @db.Timestamptz(3)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  branches          Branch[]
  memberships       TenantMembership[]
  invitations       Invitation[]
  customers         Customer[]
  categories        Category[]
  suppliers         Supplier[]
  products          Product[]
  messagingChannels MessagingChannel[]
  messageTemplates  MessageTemplate[]
  settings          Setting[]
  documentTemplates DocumentTemplate[]
  issuedDocuments   IssuedDocument[]
  reportExports     ReportExport[]
  counters          Counter[]
  subscription      Subscription?
  billingInvoices   BillingInvoice[]
  featureUsage      FeatureUsage[]
  supportGrants     SupportAccessGrant[]

  @@index([status])
  @@map("tenants")
}

model Branch {
  id            String       @id @default(uuid(7)) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  name          String       @db.VarChar(120)
  phone         String?      @db.VarChar(20)
  address       Json?
  timezone      String       @default("America/Sao_Paulo") @db.VarChar(64)
  businessHours Json?        @map("business_hours")
  status        ActiveStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membershipBranches MembershipBranch[]
  serviceOrders     ServiceOrder[]
  stockLocations    StockLocation[]
  stockMovements    StockMovement[]
  transfersOut      StockTransfer[]    @relation("TransferSource")
  transfersIn       StockTransfer[]    @relation("TransferDest")
  sales             Sale[]
  receivables       Receivable[]
  payments          Payment[]
  cashRegisters     CashRegister[]
  cashSessions      CashSession[]
  ledgerEntries     FinancialLedger[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("branches")
}

model TenantMembership {
  id        String           @id @default(uuid(7)) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      TenantRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user     User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  branches MembershipBranch[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId])
  @@map("tenant_memberships")
}

/// Associação membro↔filial. `isTechnician` = habilitação técnica operacional
/// na filial; é o que consome vaga de técnico do plano (17.1).
model MembershipBranch {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  isTechnician Boolean  @default(false) @map("is_technician")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  membership TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  branch     Branch           @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@unique([membershipId, branchId])
  @@index([tenantId, branchId, isTechnician])
  @@map("membership_branches")
}

model Invitation {
  id                  String     @id @default(uuid(7)) @db.Uuid
  tenantId            String     @map("tenant_id") @db.Uuid
  email               String     @db.VarChar(254)
  role                TenantRole
  branchIds           String[]   @map("branch_ids") @db.Uuid
  technicianBranchIds String[]   @map("technician_branch_ids") @db.Uuid
  tokenHash           String     @unique @map("token_hash") @db.VarChar(128)
  expiresAt           DateTime   @map("expires_at") @db.Timestamptz(3)
  acceptedAt          DateTime?  @map("accepted_at") @db.Timestamptz(3)
  revokedAt           DateTime?  @map("revoked_at") @db.Timestamptz(3)
  invitedBy           String     @map("invited_by") @db.Uuid
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, email])
  @@map("invitations")
}

/// Acesso temporário de suporte da plataforma, autorizado pelo tenant e auditado.
model SupportAccessGrant {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  platformUserId String    @map("platform_user_id") @db.Uuid
  reason         String    @db.VarChar(500)
  grantedBy      String    @map("granted_by") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, platformUserId, expiresAt])
  @@map("support_access_grants")
}

model Plan {
  id                        String        @id @default(uuid(7)) @db.Uuid
  code                      String        @unique @db.VarChar(40)
  name                      String        @db.VarChar(80)
  priceCents                Int           @map("price_cents")
  currency                  String        @default("BRL") @db.Char(3)
  billingPeriod             BillingPeriod @default(MONTHLY) @map("billing_period")
  maxBranches               Int           @map("max_branches")
  maxTechniciansPerBranch   Int           @default(3) @map("max_technicians_per_branch")
  maxCashRegistersPerBranch Int           @default(1) @map("max_cash_registers_per_branch")
  limitsJson                Json          @default("{}") @map("limits_json")
  featuresJson              Json          @default("[]") @map("features_json")
  active                    Boolean       @default(true)
  priceVersion              Int           @default(1) @map("price_version")
  sortOrder                 Int           @default(0) @map("sort_order")
  createdAt                 DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  priceHistory          PlanPriceHistory[]
  subscriptions         Subscription[]     @relation("SubscriptionPlan")
  scheduledSubscriptions Subscription[]    @relation("SubscriptionScheduledPlan")
  invoices              BillingInvoice[]
  changesFrom           PlanChangeRequest[] @relation("PlanChangeFrom")
  changesTo             PlanChangeRequest[] @relation("PlanChangeTo")

  @@map("plans")
}

model PlanPriceHistory {
  id          String   @id @default(uuid(7)) @db.Uuid
  planId      String   @map("plan_id") @db.Uuid
  version     Int
  priceCents  Int      @map("price_cents")
  effectiveAt DateTime @map("effective_at") @db.Timestamptz(3)
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([planId, version])
  @@map("plan_price_history")
}

model Subscription {
  id                     String             @id @default(uuid(7)) @db.Uuid
  tenantId               String             @unique @map("tenant_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  /// Preço travado desta assinatura (não sobrescrito por mudança de tabela).
  priceCents             Int                @map("price_cents")
  provider               BillingProvider    @default(MERCADO_PAGO)
  paymentMode            PaymentMode        @map("payment_mode")
  status                 SubscriptionStatus @default(PENDING_PAYMENT)
  anchorDay              Int?               @map("anchor_day")
  currentPeriodStart     DateTime?          @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd       DateTime?          @map("current_period_end") @db.Timestamptz(3)
  graceUntil             DateTime?          @map("grace_until") @db.Timestamptz(3)
  providerSubscriptionId String?            @unique @map("provider_subscription_id") @db.VarChar(120)
  providerSubscriptionStatus String?        @map("provider_subscription_status") @db.VarChar(40)
  providerPayerRef       String?            @map("provider_payer_ref") @db.VarChar(120)
  externalReference      String             @unique @map("external_reference") @db.VarChar(64)
  scheduledPlanId        String?            @map("scheduled_plan_id") @db.Uuid
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  cancelRequestedAt      DateTime?          @map("cancel_requested_at") @db.Timestamptz(3)
  providerCancelPending  Boolean            @default(false) @map("provider_cancel_pending")
  suspendedAt            DateTime?          @map("suspended_at") @db.Timestamptz(3)
  canceledAt             DateTime?          @map("canceled_at") @db.Timestamptz(3)
  activatedAt            DateTime?          @map("activated_at") @db.Timestamptz(3)
  version                Int                @default(0)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan          Plan                @relation("SubscriptionPlan", fields: [planId], references: [id], onDelete: Restrict)
  scheduledPlan Plan?               @relation("SubscriptionScheduledPlan", fields: [scheduledPlanId], references: [id], onDelete: Restrict)
  invoices      BillingInvoice[]
  planChanges   PlanChangeRequest[]

  @@index([status, currentPeriodEnd])
  @@index([status, graceUntil])
  @@map("subscriptions")
}

model BillingInvoice {
  id                 String        @id @default(uuid(7)) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  subscriptionId     String        @map("subscription_id") @db.Uuid
  planId             String        @map("plan_id") @db.Uuid
  kind               InvoiceKind   @default(SUBSCRIPTION)
  periodStart        DateTime      @map("period_start") @db.Timestamptz(3)
  periodEnd          DateTime      @map("period_end") @db.Timestamptz(3)
  amountCents        Int           @map("amount_cents")
  currency           String        @default("BRL") @db.Char(3)
  dueAt              DateTime      @map("due_at") @db.Timestamptz(3)
  status             InvoiceStatus @default(OPEN)
  paidAt             DateTime?     @map("paid_at") @db.Timestamptz(3)
  providerInvoiceRef String?       @map("provider_invoice_ref") @db.VarChar(120)
  externalReference  String        @unique @map("external_reference") @db.VarChar(64)
  /// Período já aplicado à assinatura (garante prorrogação única).
  appliedAt          DateTime?     @map("applied_at") @db.Timestamptz(3)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscription Subscription            @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  plan         Plan                    @relation(fields: [planId], references: [id], onDelete: Restrict)
  attempts     BillingPaymentAttempt[]
  payments     BillingPayment[]
  planChanges  PlanChangeRequest[]

  @@unique([subscriptionId, periodStart])
  @@index([tenantId, status])
  @@index([status, dueAt])
  @@map("billing_invoices")
}

model BillingPaymentAttempt {
  id                 String               @id @default(uuid(7)) @db.Uuid
  invoiceId          String               @map("invoice_id") @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  provider           BillingProvider      @default(MERCADO_PAGO)
  method             BillingMethod
  providerPaymentId  String?              @unique @map("provider_payment_id") @db.VarChar(120)
  idempotencyKey     String               @unique @map("idempotency_key") @db.VarChar(120)
  amountCents        Int                  @map("amount_cents")
  status             BillingPaymentStatus @default(CREATED)
  statusDetail       String?              @map("status_detail") @db.VarChar(120)
  qrPayloadEncrypted String?              @map("qr_payload_encrypted")
  qrExpiresAt        DateTime?            @map("qr_expires_at") @db.Timestamptz(3)
  ticketUrl          String?              @map("ticket_url")
  checkoutUrl        String?              @map("checkout_url")
  attemptNo          Int                  @default(1) @map("attempt_no")
  errorCode          String?              @map("error_code") @db.VarChar(120)
  /// Garante no máximo uma cobrança ativa por fatura (= invoice_id quando ativa).
  activeLock         String?              @unique @map("active_lock") @db.Uuid
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

