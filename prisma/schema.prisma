// OrdemCerta — schema PostgreSQL 17 (seções 5 e 17.8 da especificação).
//
// Convenções:
// - IDs UUIDv7; timestamps timestamptz (UTC); valores financeiros em centavos inteiros.
// - Toda tabela de negócio tem tenant_id. Relações obrigatórias entre entidades de
//   tenant usam FK composta (tenant_id, x_id) -> (tenant_id, id), impedindo
//   associação entre tenants no nível do banco. Referências opcionais são
//   protegidas por trigger (migration 20261008000100_rls_integrity).
// - RLS deny-by-default com `SET LOCAL app.tenant_id` (ver migration rls_and_integrity).
// - Registros financeiros, de estoque e de auditoria: ON DELETE RESTRICT e
//   imutabilidade por trigger.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  // Usado somente pelo Prisma Migrate (papel dono do schema). A aplicação
  // conecta com DATABASE_URL (papel sem BYPASSRLS) via datasourceUrl.
  url      = env("DATABASE_MIGRATION_URL")
}

