}

/* ================================================== CATÁLOGO E ESTOQUE */

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("categories")
}

model Supplier {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(160)
  document    String?  @db.VarChar(20)
  phone       String?  @db.VarChar(20)
  email       String?  @db.VarChar(254)
  contactName String?  @map("contact_name") @db.VarChar(120)
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@map("suppliers")
}

model Product {
  id              String      @id @default(uuid(7)) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  sku             String      @db.VarChar(60)
  barcode         String?     @db.VarChar(60)
  name            String      @db.VarChar(160)
  description     String?
  categoryId      String?     @map("category_id") @db.Uuid
  supplierId      String?     @map("supplier_id") @db.Uuid
  kind            ProductKind @default(PRODUCT)
  unit            String      @default("UN") @db.VarChar(10)
  costCents       Int         @default(0) @map("cost_cents")
  priceCents      Int         @map("price_cents")
  promoPriceCents Int?        @map("promo_price_cents")
  minStock        Int         @default(0) @map("min_stock")
  active          Boolean     @default(true)
  location        String?     @db.VarChar(60)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  compatibility  ProductCompatibility[]
  balances       StockBalance[]
  movements      StockMovement[]
  reservations   StockReservation[]
  transferLines  StockTransferLine[]
  saleItems      SaleItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, id])
  @@index([tenantId, barcode])
  @@index([tenantId, name])
  @@map("products")
}

model ProductCompatibility {
  id        String @id @default(uuid(7)) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  brand     String @db.VarChar(60)
  model     String @db.VarChar(80)

  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, brand, model])
  @@map("product_compatibility")
}

model StockLocation {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  name      String   @db.VarChar(60)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  branch       Branch             @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  balances     StockBalance[]
  movements    StockMovement[]
  reservations StockReservation[]

  @@unique([tenantId, branchId, name])
  @@unique([tenantId, id])
  @@map("stock_locations")
}

model StockBalance {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  onHand     Int      @default(0) @map("on_hand")
  reserved   Int      @default(0)
  version    Int      @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  location StockLocation @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  product  Product       @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@unique([locationId, productId])
  @@index([tenantId, productId])
  @@map("stock_balances")
}

/// Movimentações imutáveis: quantity com sinal (+ entrada, - saída).
model StockMovement {
  id               String            @id @default(uuid(7)) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  branchId         String            @map("branch_id") @db.Uuid
  locationId       String            @map("location_id") @db.Uuid
  productId        String            @map("product_id") @db.Uuid
  type             StockMovementType
  quantity         Int
  unitCostCents    Int               @default(0) @map("unit_cost_cents")
  referenceType    String?           @map("reference_type") @db.VarChar(40)
  referenceId      String?           @map("reference_id") @db.Uuid
  reason           String?           @db.VarChar(300)
  overrideNegative Boolean           @default(false) @map("override_negative")
  actorId          String            @map("actor_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  branch   Branch        @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  location StockLocation @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  product  Product       @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, productId, createdAt])
  @@index([tenantId, referenceType, referenceId])
  @@map("stock_movements")
}

model StockReservation {
  id          String            @id @default(uuid(7)) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  orderId     String            @map("order_id") @db.Uuid
  productId   String            @map("product_id") @db.Uuid
  locationId  String            @map("location_id") @db.Uuid
  quantity    Int
  consumedQty Int               @default(0) @map("consumed_qty")
  status      ReservationStatus @default(ACTIVE)
  createdBy   String            @map("created_by") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  order    ServiceOrder  @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  product  Product       @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  location StockLocation @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, orderId, status])
  @@map("stock_reservations")
}

model StockTransfer {
  id               String         @id @default(uuid(7)) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  number           Int
  sourceBranchId   String         @map("source_branch_id") @db.Uuid
  destBranchId     String         @map("dest_branch_id") @db.Uuid
  sourceLocationId String         @map("source_location_id") @db.Uuid
  destLocationId   String         @map("dest_location_id") @db.Uuid
  status           TransferStatus @default(IN_TRANSIT)
  notes            String?        @db.VarChar(500)
  receiveNotes     String?        @map("receive_notes") @db.VarChar(500)
  createdBy        String         @map("created_by") @db.Uuid
  receivedBy       String?        @map("received_by") @db.Uuid
  sentAt           DateTime       @default(now()) @map("sent_at") @db.Timestamptz(3)
  receivedAt       DateTime?      @map("received_at") @db.Timestamptz(3)
  version          Int            @default(0)

  sourceBranch Branch              @relation("TransferSource", fields: [tenantId, sourceBranchId], references: [tenantId, id], onDelete: Restrict)
  destBranch   Branch              @relation("TransferDest", fields: [tenantId, destBranchId], references: [tenantId, id], onDelete: Restrict)
  lines        StockTransferLine[]

  @@unique([tenantId, number])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("stock_transfers")
}

model StockTransferLine {
  id               String @id @default(uuid(7)) @db.Uuid
  tenantId         String @map("tenant_id") @db.Uuid
  transferId       String @map("transfer_id") @db.Uuid
  productId        String @map("product_id") @db.Uuid
  quantitySent     Int    @map("quantity_sent")
  quantityReceived Int?   @map("quantity_received")
  unitCostCents    Int    @default(0) @map("unit_cost_cents")

  transfer StockTransfer @relation(fields: [tenantId, transferId], references: [tenantId, id], onDelete: Restrict)
  product  Product       @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, transferId])
  @@map("stock_transfer_lines")
}

/* ======================================================= PDV E FINANCEIRO */

model Sale {
  id            String     @id @default(uuid(7)) @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  branchId      String     @map("branch_id") @db.Uuid
  number        Int
  customerId    String?    @map("customer_id") @db.Uuid
  orderId       String?    @map("order_id") @db.Uuid
  cashSessionId String?    @map("cash_session_id") @db.Uuid
  createdBy     String     @map("created_by") @db.Uuid
  status        SaleStatus @default(DRAFT)
  subtotalCents Int        @default(0) @map("subtotal_cents")
  discountCents Int        @default(0) @map("discount_cents")
  totalCents    Int        @default(0) @map("total_cents")
  refundedCents Int        @default(0) @map("refunded_cents")
  confirmedAt   DateTime?  @map("confirmed_at") @db.Timestamptz(3)
  canceledAt    DateTime?  @map("canceled_at") @db.Timestamptz(3)
  cancelReason  String?    @map("cancel_reason") @db.VarChar(500)
  version       Int        @default(0)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch Branch     @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  items  SaleItem[]

  @@unique([tenantId, number])
  @@unique([tenantId, id])
  @@index([tenantId, branchId, status, createdAt])
  @@map("sales")
}

model SaleItem {
  id             String @id @default(uuid(7)) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  saleId         String @map("sale_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid
  description    String @db.VarChar(160)
  qty            Int
  refundedQty    Int    @default(0) @map("refunded_qty")
  unitPriceCents Int    @map("unit_price_cents")
  unitCostCents  Int    @map("unit_cost_cents")
  discountCents  Int    @default(0) @map("discount_cents")

  sale    Sale    @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict)
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, saleId])
  @@map("sale_items")
}

/// Uma cobrança por origem (venda ou OS): impede duplicidade de faturamento.
model Receivable {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  branchId    String           @map("branch_id") @db.Uuid
  sourceType  ReceivableSource @map("source_type")
  sourceId    String           @map("source_id") @db.Uuid
  customerId  String?          @map("customer_id") @db.Uuid
  amountCents Int              @map("amount_cents")
  paidCents   Int              @default(0) @map("paid_cents")
  refundedCents Int            @default(0) @map("refunded_cents")
  dueAt       DateTime?        @map("due_at") @db.Timestamptz(3)
  status      ReceivableStatus @default(OPEN)
  version     Int              @default(0)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch      Branch              @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  allocations PaymentAllocation[]

  @@unique([tenantId, sourceType, sourceId])
  @@unique([tenantId, id])
  @@index([tenantId, branchId, status])
  @@map("receivables")
}

model Payment {
  id             String        @id @default(uuid(7)) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  branchId       String        @map("branch_id") @db.Uuid
  cashSessionId  String?       @map("cash_session_id") @db.Uuid
  method         PaymentMethod
  amountCents    Int           @map("amount_cents")
  tenderedCents  Int?          @map("tendered_cents")
  changeCents    Int           @default(0) @map("change_cents")
  refundedCents  Int           @default(0) @map("refunded_cents")
  status         PaymentStatus @default(CONFIRMED)
  /// Sem integração de adquirência: recebimento registrado manualmente.
  provider       String        @default("MANUAL") @db.VarChar(40)
  isManual       Boolean       @default(true) @map("is_manual")
  externalId     String?       @map("external_id") @db.VarChar(120)
  idempotencyKey String        @map("idempotency_key") @db.VarChar(120)
  receivedBy     String        @map("received_by") @db.Uuid
  receivedAt     DateTime      @default(now()) @map("received_at") @db.Timestamptz(3)
  notes          String?       @db.VarChar(500)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  branch      Branch              @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  allocations PaymentAllocation[]
  refunds     Refund[]

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, id])
  @@index([tenantId, branchId, receivedAt])
  @@index([tenantId, cashSessionId])
  @@map("payments")
}

model PaymentAllocation {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  paymentId    String   @map("payment_id") @db.Uuid
  receivableId String   @map("receivable_id") @db.Uuid
  amountCents  Int      @map("amount_cents")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  payment    Payment    @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict)
  receivable Receivable @relation(fields: [tenantId, receivableId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, receivableId])
  @@map("payment_allocations")
}

model Refund {
  id            String       @id @default(uuid(7)) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  paymentId     String       @map("payment_id") @db.Uuid
  cashSessionId String?      @map("cash_session_id") @db.Uuid
  amountCents   Int          @map("amount_cents")
  reason        String       @db.VarChar(500)
  status        RefundStatus @default(COMPLETED)
  createdBy     String       @map("created_by") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, paymentId])
  @@map("refunds")
}

model CashRegister {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  name      String   @db.VarChar(60)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch   Branch        @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  sessions CashSession[]

  @@unique([tenantId, branchId, name])
  @@unique([tenantId, id])
  @@map("cash_registers")
}

model CashSession {
  id                  String            @id @default(uuid(7)) @db.Uuid
  tenantId            String            @map("tenant_id") @db.Uuid
  branchId            String            @map("branch_id") @db.Uuid
  registerId          String            @map("register_id") @db.Uuid
  openedBy            String            @map("opened_by") @db.Uuid
  openedAt            DateTime          @default(now()) @map("opened_at") @db.Timestamptz(3)
  openingFloatCents   Int               @map("opening_float_cents")
  status              CashSessionStatus @default(OPEN)
  /// = register_id enquanto aberta: impede sessões simultâneas no mesmo caixa.
  openLock            String?           @unique @map("open_lock") @db.Uuid
  closedBy            String?           @map("closed_by") @db.Uuid
  closedAt            DateTime?         @map("closed_at") @db.Timestamptz(3)
  declaredTotalsJson  Json?             @map("declared_totals_json")
  expectedTotalsJson  Json?             @map("expected_totals_json")
  differenceCents     Int?              @map("difference_cents")
  closeNotes          String?           @map("close_notes") @db.VarChar(1000)
  closedWhileSuspended Boolean          @default(false) @map("closed_while_suspended")
  version             Int               @default(0)

  branch    Branch         @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  register  CashRegister   @relation(fields: [tenantId, registerId], references: [tenantId, id], onDelete: Restrict)
  movements CashMovement[]

  @@unique([tenantId, id])
  @@index([tenantId, branchId, status])
  @@index([tenantId, openedBy, status])
  @@map("cash_sessions")
}

/// Dinheiro físico e movimentos do caixa (imutável).
model CashMovement {
  id             String           @id @default(uuid(7)) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  cashSessionId  String           @map("cash_session_id") @db.Uuid
  type           CashMovementType
  method         PaymentMethod
  amountCents    Int              @map("amount_cents")
  paymentId      String?          @map("payment_id") @db.Uuid
  reason         String?          @db.VarChar(300)
  idempotencyKey String?          @map("idempotency_key") @db.VarChar(120)
  actorId        String           @map("actor_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  session CashSession @relation(fields: [tenantId, cashSessionId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, cashSessionId])
  @@map("cash_movements")
}

/// Ledger imutável. Ajustes por lançamento compensatório.
model FinancialLedger {
  id           String          @id @default(uuid(7)) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  branchId     String          @map("branch_id") @db.Uuid
  sourceType   String          @map("source_type") @db.VarChar(40)
  sourceId     String          @map("source_id") @db.Uuid
  entryType    LedgerEntryType @map("entry_type")
  amountCents  Int             @map("amount_cents")
  method       PaymentMethod?
  competenceAt DateTime        @default(now()) @map("competence_at") @db.Timestamptz(3)
  memo         String?         @db.VarChar(300)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, branchId, entryType, competenceAt])
  @@index([tenantId, sourceType, sourceId])
  @@map("financial_ledger")
}

/* =================================================== MENSAGENS E CONFIGS */

model MessagingChannel {
  id                        String                 @id @default(uuid(7)) @db.Uuid
  tenantId                  String                 @map("tenant_id") @db.Uuid
  branchId                  String?                @map("branch_id") @db.Uuid
  name                      String                 @db.VarChar(80)
  provider                  MessagingProviderKind
  status                    MessagingChannelStatus @default(NOT_CONNECTED)
  encryptedCredentialsRef   String?                @map("encrypted_credentials_ref")
  externalPhoneId           String?                @unique @map("external_phone_id") @db.VarChar(40)
  externalWabaId            String?                @map("external_waba_id") @db.VarChar(40)
  displayPhoneMasked        String?                @map("display_phone_masked") @db.VarChar(30)
  billingStatus             MessagingBillingStatus @default(UNKNOWN) @map("billing_status")
  billingVerifiedAt         DateTime?              @map("billing_verified_at") @db.Timestamptz(3)
  billingVerificationMethod String?                @map("billing_verification_method") @db.VarChar(20)
  tokenExpiresAt            DateTime?              @map("token_expires_at") @db.Timestamptz(3)
  webhookLastReceivedAt     DateTime?              @map("webhook_last_received_at") @db.Timestamptz(3)
  firstDeliveredAt          DateTime?              @map("first_delivered_at") @db.Timestamptz(3)
  lastError                 String?                @map("last_error") @db.VarChar(500)
  connectedAt               DateTime?              @map("connected_at") @db.Timestamptz(3)
  disconnectedAt            DateTime?              @map("disconnected_at") @db.Timestamptz(3)
  version                   Int                    @default(0)
  createdAt                 DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  billingChecks MessagingBillingCheck[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("messaging_channels")
}

model MessagingBillingCheck {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  channelId   String   @map("channel_id") @db.Uuid
  status      MessagingBillingStatus
  method      String   @db.VarChar(20)
  evidenceRef String?  @map("evidence_ref")
  checkedBy   String   @map("checked_by") @db.Uuid
  checkedAt   DateTime @default(now()) @map("checked_at") @db.Timestamptz(3)
  notes       String?

  channel MessagingChannel @relation(fields: [tenantId, channelId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, channelId])
  @@map("messaging_billing_checks")
}

model MessageTemplate {
  id                 String                 @id @default(uuid(7)) @db.Uuid
  tenantId           String                 @map("tenant_id") @db.Uuid
  eventType          String                 @map("event_type") @db.VarChar(40)
  provider           MessagingProviderKind  @default(WHATSAPP_CLOUD)
  name               String                 @db.VarChar(512)
  language           String                 @default("pt_BR") @db.VarChar(10)
  body               String
  variablesJson      Json                   @default("[]") @map("variables_json")
  externalTemplateId String?                @map("external_template_id") @db.VarChar(60)
  approvalStatus     TemplateApprovalStatus @default(DRAFT) @map("approval_status")
  enabled            Boolean                @default(true)
  version            Int                    @default(1)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, eventType, provider])
  @@unique([tenantId, id])
  @@map("message_templates")
}

/// Outbox transacional: eventos de domínio gravados na mesma transação da mudança de estado.
model NotificationOutbox {
  id            String       @id @default(uuid(7)) @db.Uuid
  tenantId      String?      @map("tenant_id") @db.Uuid
  eventId       String       @unique @map("event_id") @db.Uuid
  eventType     String       @map("event_type") @db.VarChar(60)
  aggregateType String       @map("aggregate_type") @db.VarChar(40)
  aggregateId   String       @map("aggregate_id") @db.Uuid
  payloadJson   Json         @map("payload_json")
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  lastError     String?      @map("last_error") @db.VarChar(1000)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@map("notification_outbox")
}

model MessageDelivery {
  id                String            @id @default(uuid(7)) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  channelId         String?           @map("channel_id") @db.Uuid
  orderId           String?           @map("order_id") @db.Uuid
  customerId        String            @map("customer_id") @db.Uuid
  templateId        String?           @map("template_id") @db.Uuid
  eventId           String            @map("event_id") @db.Uuid
  eventType         String            @map("event_type") @db.VarChar(40)
  /// event_id + template + destinatário (hash): deduplicação.
  dedupeKey         String            @unique @map("dedupe_key") @db.VarChar(64)
  recipientMasked   String            @map("recipient_masked") @db.VarChar(30)
  status            DeliveryMsgStatus @default(QUEUED)
  providerMessageId String?           @unique @map("provider_message_id") @db.VarChar(120)
  attempts          Int               @default(0)
  lastError         String?           @map("last_error") @db.VarChar(500)
  sentAt            DateTime?         @map("sent_at") @db.Timestamptz(3)
  deliveredAt       DateTime?         @map("delivered_at") @db.Timestamptz(3)
  readAt            DateTime?         @map("read_at") @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, orderId])
  @@map("message_deliveries")
}

model Setting {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  /// "tenant" ou o branch_id: permite UNIQUE sem NULL.
  scope     String   @db.VarChar(40)
  key       String   @db.VarChar(80)
  valueJson Json     @map("value_json")
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, scope, key])
  @@map("settings")
}

model DocumentTemplate {
  id        String               @id @default(uuid(7)) @db.Uuid
  tenantId  String               @map("tenant_id") @db.Uuid
  type      DocumentTemplateType
  version   Int
  content   String
  active    Boolean              @default(true)
  createdBy String?              @map("created_by") @db.Uuid
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, type, version])
  @@index([tenantId, type, active])
  @@map("document_templates")
}

/// Registro de emissão: versão do modelo, checksum SHA-256, momento e usuário.
model IssuedDocument {
  id              String               @id @default(uuid(7)) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  type            DocumentTemplateType
  templateVersion Int                  @map("template_version")
  referenceType   String               @map("reference_type") @db.VarChar(40)
  referenceId     String               @map("reference_id") @db.Uuid
  checksum        String               @db.VarChar(64)
  format          String               @default("A4") @db.VarChar(10)
  issuedBy        String?              @map("issued_by") @db.Uuid
  issuedAt        DateTime             @default(now()) @map("issued_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, referenceType, referenceId])
  @@map("issued_documents")
}

model ReportExport {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  requestedBy String       @map("requested_by") @db.Uuid
  reportType  String       @map("report_type") @db.VarChar(40)
  format      ExportFormat
  paramsJson  Json         @map("params_json")
  status      ExportStatus @default(QUEUED)
  /// Arquivo gerado (CSV/PDF) guardado no banco até expirar (7 dias); removido pela manutenção.
  content     Bytes?
  contentType String?      @map("content_type") @db.VarChar(60)
  error       String?      @db.VarChar(500)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt DateTime?    @map("completed_at") @db.Timestamptz(3)
  expiresAt   DateTime?    @map("expires_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@map("report_exports")
}
