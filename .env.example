# OrdemCerta — variáveis de ambiente (sem segredos). Copie para .env e preencha.
# Segredos reais NUNCA no Git. Em produção, prefira um secret manager.

NODE_ENV=production
LOG_LEVEL=info

# Domínio (validar DNS/TLS antes do go-live)
APP_DOMAIN=ordemcerta.adapterco.com.br
APP_URL=https://ordemcerta.adapterco.com.br
CORS_ORIGINS=https://ordemcerta.adapterco.com.br
API_PORT=3001
TRUST_PROXY=true

# Traefik existente (verificar nomes efetivos: docker network ls / labels do Traefik)
TRAEFIK_NETWORK=traefik9
TRAEFIK_ENTRYPOINT=https
TRAEFIK_CERT_RESOLVER=letsencrypt

# PostgreSQL 17 — três papéis (infra/docker/postgres/init/01-roles.sh)
POSTGRES_PASSWORD=
OC_OWNER_PASSWORD=
OC_APP_PASSWORD=
OC_SYSTEM_PASSWORD=
# Dono do schema: somente Prisma Migrate (job de migração)
DATABASE_MIGRATION_URL=postgresql://ordemcerta_owner:${OC_OWNER_PASSWORD}@postgres:5432/ordemcerta
# Papel da aplicação (RLS obrigatório, sem BYPASSRLS)
DATABASE_URL=postgresql://ordemcerta_app:${OC_APP_PASSWORD}@postgres:5432/ordemcerta?connection_limit=20
# Papel de sistema (BYPASSRLS): auth, plataforma, billing, webhooks, worker
DATABASE_SYSTEM_URL=postgresql://ordemcerta_system:${OC_SYSTEM_PASSWORD}@postgres:5432/ordemcerta?connection_limit=10

# Redis 7
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# Segurança — gere com: openssl rand -base64 48 (JWT) / openssl rand -base64 32 (ENCRYPTION_KEY)
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=k1
# Rotação: chaves anteriores "id:base64,id:base64"
ENCRYPTION_KEYS_PREVIOUS=
COOKIE_SECURE=true

# Armazenamento S3 compatível (MinIO privado ou provedor S3). Nunca público.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=ordemcerta
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MAX_UPLOAD_MB=10
SIGNED_URL_TTL_SECONDS=120

# Antivírus (clamd). Vazio = arquivos ficam "não verificados".
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# E-mail transacional
MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OrdemCerta <nao-responda@ordemcerta.adapterco.com.br>

# Mercado Pago — conta da OPERADORA do SaaS (billing da plataforma). Homologar antes de produção.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_WEBHOOK_TOLERANCE_SECONDS=300

# Meta / WhatsApp Business Platform (Cloud API oficial; BYOK do tenant)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
META_WEBHOOK_VERIFY_TOKEN=
META_EMBEDDED_SIGNUP_ENABLED=false
META_EMBEDDED_SIGNUP_CONFIG_ID=

# OpenAPI em produção somente com autenticação básica
API_DOCS_ENABLED=false
API_DOCS_USER=
API_DOCS_PASSWORD=

# Seed (opcional): superadmin da plataforma (MFA exigida no 1º login)
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_DEMO=false

# Backup (infra/backup)
BACKUP_PASSPHRASE=
BACKUP_S3_URI=s3://bucket-offsite/ordemcerta
BACKUP_RETENTION_DAYS=30
